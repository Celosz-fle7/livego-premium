<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#031020"
                android:centerColor="#0A2B45"
                android:endColor="#020617" />
        </shape>
    </item>
    <item android:left="96dp" android:right="96dp" android:top="60dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#2217D4F8" />
            <stroke android:width="2dp" android:color="#6617D4F8" />
        </shape>
    </item>
</layer-list>
